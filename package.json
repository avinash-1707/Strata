{
  "name": "strata",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first memory layer for AI agents, served over MCP",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/migrations",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seamcheck": "./scripts/seamcheck.sh",
    "truth-find": "tsx scripts/truth-find.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:fake": "tsx tests/support/stdioHarness.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.34",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "redis": "^6.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.3",
    "eslint": "^9.17.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.10"
  }
}
