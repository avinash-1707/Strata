# Copy to .env and fill in. Never commit .env.
#
# Two deployments read this file. Uncomment the block that applies.

# --- Dev: the ephemeral Compose stack on the Mac (DD-030) --------------------
# Ports are the non-default ones docker-compose.yml publishes, so a locally
# installed Postgres/Redis cannot silently stand in for the containers.
POSTGRES_URL=postgres://strata:strata@localhost:54329/strata
REDIS_URL=redis://localhost:63790

# Models live only on the Ubuntu machine (DD-027), so in development this points
# across the LAN — or at an SSH forward — rather than at a local Ollama.
OLLAMA_URL=http://localhost:11434

# --- Ubuntu target: docker-compose.prod.yml (DD-027) ------------------------
# Service names, not localhost, and the app resolves POSTGRES_URL from
# POSTGRES_PASSWORD itself — set the password, leave the URL to compose.
#
# POSTGRES_PASSWORD=          # required; `up` fails outright when unset
# REDIS_URL=redis://redis:6379
# OLLAMA_URL=http://ollama:11434
#
# Pinned rather than :latest — /api/embed needs >= 0.3.4 and JSON-Schema
# `format` needs >= 0.5.0. Re-run `pnpm truth-find` before changing it.
# OLLAMA_IMAGE_TAG=0.32.6

# --- Both --------------------------------------------------------------------
EMBEDDING_MODEL=nomic-embed-text
# 3b or 1.5b is decided by measured CPU latency in Phase 5 (DD-028).
INSTRUCT_MODEL=qwen2.5:3b-instruct

# Generous because the target has no GPU (DD-028).
OLLAMA_TIMEOUT_MS=60000

# The deployment transport: one long-lived daemon serving REST and MCP over HTTP
# (DD-036). `stdio` is for local development against real Postgres and Redis —
# it needs no token and binds no port.
STRATA_TRANSPORT=http

# Defaults to 127.0.0.1. docker-compose.prod.yml sets 0.0.0.0 for the container,
# where a loopback bind would make the published port reach nothing. Set it here
# only to expose a *non-container* run to the LAN, and know that you are doing it.
# HTTP_HOST=
HTTP_PORT=8080

# REQUIRED under STRATA_TRANSPORT=http — the app refuses to start without it,
# rather than serving the whole corpus to the LAN (DD-036).
#
# Left commented, not blank: env_file turns `MCP_AUTH_TOKEN=` into an empty
# string rather than an absent one, and an empty value would have to satisfy the
# 32-character minimum.
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Compaction is destructive and LLM-driven, so it ships off (DD-012).
COMPACTION_ENABLED=false
