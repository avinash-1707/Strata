# Copy to .env and fill in. Never commit .env.

# Dev: the ephemeral Compose stack on the Mac (DD-030).
# Target: Compose service names on the Ubuntu box, e.g. postgres:5432 (DD-027).
POSTGRES_URL=postgres://strata:strata@localhost:5432/strata
REDIS_URL=redis://localhost:6379

# Models live only on the Ubuntu machine (DD-027), so in development this points
# across the LAN rather than at localhost.
OLLAMA_URL=http://localhost:11434

EMBEDDING_MODEL=nomic-embed-text
# 3b or 1.5b is decided by measured CPU latency in Phase 5 (DD-028).
INSTRUCT_MODEL=qwen2.5:3b-instruct

# Generous because the target has no GPU (DD-028).
OLLAMA_TIMEOUT_MS=60000

# Only used under the HTTP transport (DD-026). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Compaction is destructive and LLM-driven, so it ships off (DD-012).
COMPACTION_ENABLED=false
