{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* docs/coding-standards.md §1. noUncheckedIndexedAccess especially: db rows
       and LLM-parsed arrays are the two biggest sources of runtime undefined
       here, and both arrive through index access. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "sourceMap": true
  },
  /* Typecheck covers tests too — a test that no longer compiles is a broken test.
     scripts/ is included for the same reason: truth-find.ts is the instrument that
     settles DD-008, and an instrument that does not compile settles nothing.
     Emit settings live in tsconfig.build.json, which narrows this to src/. */
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
